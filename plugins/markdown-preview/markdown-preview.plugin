[Plugin]
Loader=python3
Module=markdown-preview
IAge=3
Name=Markdown Preview
Name[fr]=Aperçu Markdown
Name[de]=Markdown Vorschau
Description=Displays the HTML version of the current Markdown document
Description[fr]=Affiche la version HTML du document Markdown actuel
Description[de]=Zeigt die HTML Version des Markdown Textes an, der gerade editiert wird
